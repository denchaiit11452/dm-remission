# =============================================================================
# การตั้งค่า Environment Variables สำหรับ Docker บน Production Server
# คัดลอกไฟล์นี้เป็น `.env.production` บนเครื่อง Server
# แล้วสั่ง `docker compose --env-file .env.production up -d --build` (ดู README.md)
# =============================================================================

# รหัสผ่านและชื่อฐานข้อมูล PostgreSQL ของโรงพยาบาลใน Docker
# สร้างรหัสผ่านด้วย `openssl rand -hex 32` (อักขระพิเศษจะทำให้ URL เชื่อมต่อฐานข้อมูลผิด)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=dm_remission

# Supabase Auth (ใช้กับระบบ Login / Session)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

